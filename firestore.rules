rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ─────────────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }
    // Helper to get raw user data safely
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function hasRole(role) {
      return isAuth() && (
        getUserData().get('role', 'none') == role || 
        role in getUserData().get('roles', [])
      );
    }
    function isAdmin() {
      return hasRole('admin') || (isAuth() && request.auth.token.email == 'admin@admin.com');
    }
    function isTeacher() {
      return isAdmin() || hasRole('homeroom_teacher') || hasRole('subject_teacher') || hasRole('student_affairs');
    }
    function isParent() {
      return hasRole('parent');
    }

    // ── users ────────────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read:   if isAuth() && (request.auth.uid == uid || isAdmin());
      // อนุญาตให้ Admin สร้าง หรือ user สร้าง document ของตัวเองได้ครั้งแรก
      allow create: if isAuth() && (request.auth.uid == uid || isAdmin());
      // อัปเดตทั่วไป: เฉพาะ Admin หรือ user เขียนข้อมูลตัวเอง (และ Admin เท่านั้นที่เปลี่ยน role ได้)
      allow update: if isAdmin()
                    || (isAuth() && request.auth.uid == uid
                        && !('role' in request.resource.data.diff(resource.data).affectedKeys()));
      allow delete: if isAdmin();
    }

    // ── students ─────────────────────────────────────────────────────────────
    match /students/{studentId} {
      allow read:  if isTeacher() || (isParent() && resource.data.parentUid == request.auth.uid);
      allow write: if isAdmin() || hasRole('homeroom_teacher');
    }

    // ── promotionBackups ─────────────────────────────────────────────────────
    match /promotionBackups/{backupId} {
      allow read:  if isAdmin();
      allow write: if isAdmin();
    }

    // ── attendance (morning) ──────────────────────────────────────────────────
    match /attendance/{docId} {
      allow read:  if isTeacher() || isParent();
      allow write: if isTeacher();
    }

    // ── subjectAttendance ─────────────────────────────────────────────────────
    match /subjectAttendance/{docId} {
      allow read:  if isTeacher() || isParent();
      allow write: if isTeacher();
    }

    // ── subjects ──────────────────────────────────────────────────────────────
    match /subjects/{subjectId} {
      allow read:  if isAuth();
      allow create: if isTeacher();
      allow update: if isAdmin() || request.auth.uid in resource.data.canManage || resource.data.teacherId == request.auth.uid;
      allow delete: if isAdmin() || resource.data.teacherId == request.auth.uid;
    }

    // ── behaviorCriteria ──────────────────────────────────────────────────────
    match /behaviorCriteria/{criteriaId} {
      allow read:  if isTeacher();
      allow write: if isAdmin();
    }

    // ── behaviorRecords ───────────────────────────────────────────────────────
    match /behaviorRecords/{recordId} {
      allow read:  if isTeacher() || isParent();
      allow create: if isTeacher();
      allow delete: if isAdmin() || (isTeacher() && resource.data.teacherId == request.auth.uid);
      allow update: if isAdmin() || hasRole('student_affairs');
    }

    // ── settings (school-wide config: classrooms list etc.) ───────────────────
    match /settings/{docId} {
      allow read:  if isAuth();
      allow write: if isAdmin();
    }
  }
}
